# F-6 repo hygiene — keep `git status` readable. Data files are IGNORED, never
# deleted (manas.db, traderlog/data/*.db and output/ may matter).
node_modules/
__pycache__/
*.pyc
.venv*/

# logs and throwaway diagnostics
*.log
* _err.log
_agrec_*
scratch_*
_diag_*
tmp_*
test_out.txt
tests.log
playwright-verify-*.txt

# root-level artifacts
/*.png
/*.db
/=

# agent tooling + local state
.agents/
.codegraph/
.codex/
.opencode/
.playwright-cli/
.playwright-mcp/
.zai/
.zcode/
.zcode-cli/
Claude/
codebase-memory/
vendor/open-design/

# test/dead-weight outputs
_figures_out/
_frozen/
deliverables/
